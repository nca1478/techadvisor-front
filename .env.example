# Copy to .env.local and adjust for local development. Values below are EXAMPLES.
# Never put secrets in NEXT_PUBLIC_* variables — they are exposed to the browser.

# Backend API base URL for server-side code (SSR, Route Handlers, Server Actions)
API_BASE_URL=http://localhost:3001/api/v1

# Backend API base URL for browser-side code (must be reachable from the browser)
NEXT_PUBLIC_API_BASE_URL=http://localhost:3001/api/v1

# External image hosts allowed by next/image (comma-separated, https only).
# Defaults to placehold.co (seed data). Add CDN hosts here when they appear.
# NOTE: next.config.ts is read at startup — restart `npm run dev` after changing it.
IMAGE_REMOTE_HOSTS=placehold.co,speedlogic.com.co

# Public site origin for SEO (metadataBase, canonical/OG URLs, sitemap,
# robots, Product JSON-LD). Public by necessity (embedded in HTML); local
# default keeps absolute URLs working without configuration.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Payments: intentionally NO NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY. The checkout
# uses hosted Stripe Checkout (backend returns `checkoutUrl` and the browser
# redirects there), so no Stripe.js key is needed and no card data is handled
# (see docs/decisions/0007-auth-carrito-checkout.md).
