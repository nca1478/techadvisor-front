# Copy to .env.local and adjust for local development. Values below are EXAMPLES.
# Never put secrets in NEXT_PUBLIC_* variables — they are exposed to the browser.

# Backend API base URL for server-side code (SSR, Route Handlers, Server Actions)
API_BASE_URL=http://localhost:3001/api/v1

# Backend API base URL for browser-side code (must be reachable from the browser)
NEXT_PUBLIC_API_BASE_URL=http://localhost:3001/api/v1

# External image hosts allowed by next/image (comma-separated, https only).
# Defaults to placehold.co (seed data). Add CDN hosts here when they appear.
IMAGE_REMOTE_HOSTS=placehold.co
